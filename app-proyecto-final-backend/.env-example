# API CONFIG

PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/gestion_documental?replicaSet=rs0
CORS_ORIGIN=http://localhost:4200
DEFAULT_QUOTA_BYTES=1073741824

JWT_SECRET=un-secreto-largo-y-aleatorio-de-mas-de-16-caracteres
JWT_EXPIRES_IN_SECONDS=900
REFRESH_EXPIRES_IN_SECONDS=86400
COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token



# ARGON2 CONFIG

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1



# MONGODB (read by docker-compose)

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=<generated>
MONGO_APP_DB=gestion_documental
MONGO_APP_USER=gestion_app
MONGO_APP_PASSWORD=<generated>

# MONGODB (read by the API)
MONGODB_URI=mongodb://gestion_app:<app-password>@localhost:27017/gestion_documental?replicaSet=rs0&authSource=gestion_documental

# MIGRATIONS (read by ts-migrate-mongoose)
MIGRATE_MONGO_URI=mongodb://gestion_app:<app-password>@localhost:27017/gestion_documental?replicaSet=rs0&authSource=gestion_documental